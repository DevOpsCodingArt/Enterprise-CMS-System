# ==========================================================
# PRIME ONE INFRASTRUCTURE & APPLICATION ENVIRONMENT (EXAMPLE)
# ==========================================================

# Core Application Settings
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000

# PostgreSQL + PostGIS Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=primeone_user
DB_PASSWORD=your_secure_password
DB_NAME=primeone
DATABASE_URL=postgresql://primeone_user:your_secure_password@localhost:5432/primeone

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_URL=redis://:your_redis_password@localhost:6379

# Security & JWT Tokens
JWT_ACCESS_SECRET=your_super_secret_access_key
JWT_REFRESH_SECRET=your_super_secret_refresh_key
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# File Storage (Cloudflare R2 / S3 Compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=primeone-media
R2_PUBLIC_DEV_URL=http://localhost:4000/uploads
UPLOAD_DIR=./uploads

# Push Notifications & Email
FCM_SERVER_KEY=
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Prime One <noreply@primeone.io>"
